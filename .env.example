# 複製為 .env 後依需要修改：cp .env.example .env（正式環境變數優先於 .env）

# ── 基本設定 ──────────────────────────────────────────────────────
# 後端 WebSocket 監聽埠
CHAT_PORT=4001

# ── Supabase 雲端儲存（選用） ─────────────────────────────────────
# 設定後各聊天室的對話流程、房間與 FAQ 都會存進 Supabase
# （買張無保險金的 free 資料庫即可）。
# 取得方式：Supabase Dashboard → 你的專案 → Settings → API Keys →
# 複製 service_role / secret key（server 端專用，切勿分享或放入前端）
SUPABASE_URL=https://uhunwwvjzuaauklzzuwk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM 智慧答詢（小幫手，選用） ───────────────────────────────────
# 任何 OpenAI 相容的 chat/completions 端點：OpenAI / LM Studio / Ollama 等
# local Ollama 範例：CHAT_LLM_BASE_URL=http://localhost:11434/v1
# local LM Studio 範例：CHAT_LLM_BASE_URL=http://localhost:1234/v1
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=ollama
CHAT_LLM_MODEL=

# 注意：CHAT_LLM_BASE_URL 與 CHAT_LLM_MODEL 都設定後才會啟用 LLM；
# 未設定時「小幫手」自動退回內建罐頭回覆，程式仍可正常運作。

# ── 聊天室壽命（選用，通常不打開） ─────────────────────────────────
# 自建聊天室存活毫秒數，正式預設 1 小時（3600000）。
# 測試時可設小值，例如 3000（3 秒）觀察逾時解散。
CHAT_ROOM_LIFETIME_MS=3600000
