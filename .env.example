# 複製為 .env 後依需要修改：cp .env.example .env（正式環境變數優先於 .env）

# ── 基本設定 ──────────────────────────────────────────────────────
# 後端 WebSocket 監聽埠
CHAT_PORT=4001

# ── Supabase 雲端儲存（選用） ─────────────────────────────────────
# 設定後各聊天室的對話流程、房間與 FAQ 都會存進 Supabase
# （買張無保險金的 free 資料庫即可）。
# 取得方式：Supabase Dashboard → 你的專案 → Settings → API Keys →
# 複製 service_role / secret key（server 端專用，切勿分享或放入前端）
SUPABASE_URL=https://uhunwwvjzuaauklzzuwk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM 智慧答詢（小幫手，選用） ───────────────────────────────────
# 任何 OpenAI 相容的 chat/completions 端點：OpenAI / Gemini / Groq / LM Studio / Ollama 等
# local Ollama 範例：CHAT_LLM_BASE_URL=http://localhost:11434/v1
# local LM Studio 範例：CHAT_LLM_BASE_URL=http://localhost:1234/v1
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=ollama
CHAT_LLM_MODEL=

# ── LLM 備援路由（選用） ──────────────────────────────────────────
# 主路由（CHAT_LLM_*）限流／失敗時會自動往下試，全部失敗才退回罐頭回覆
# Google AI Studio（Gemini）：https://aistudio.google.com/apikey
# CHAT_LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_LLM2_API_KEY=
# CHAT_LLM2_MODEL=gemini-flash-latest
# Groq（免費、速度快）：https://console.groq.com/keys
# CHAT_LLM3_BASE_URL=https://api.groq.com/openai/v1
# CHAT_LLM3_API_KEY=
# CHAT_LLM3_MODEL=openai/gpt-oss-120b
# Cloudflare Workers AI：https://dash.cloudflare.com/profile/api-tokens（Token 需 Workers AI Edit 權限）
# CHAT_LLM4_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<AccountID>/ai/v1
# CHAT_LLM4_API_KEY=
# CHAT_LLM4_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 注意：CHAT_LLM_BASE_URL 與 CHAT_LLM_MODEL 都設定後才會啟用 LLM；
# 未設定時「小幫手」自動退回內建罐頭回覆，程式仍可正常運作。

# ── 聊天室壽命（選用，通常不打開） ─────────────────────────────────
# 自建聊天室存活毫秒數，正式預設 1 小時（3600000）。
# 測試時可設小值，例如 3000（3 秒）觀察逾時解散。
CHAT_ROOM_LIFETIME_MS=3600000
